  "tokens": [
    {
      "id": "primary",
      "name": "品牌主色",
      "group": "颜色",
      "type": "color",
      "value": "#4f46e5",
      "description": "主按钮、链接和选中状态。",
      "cssVariable": "--color-primary"
    },
    {
      "id": "primary-hover",
      "name": "品牌悬停",
      "group": "颜色",
      "type": "color",
      "value": "#4338ca",
      "description": "主按钮在悬停时加深。",
      "cssVariable": "--color-primary-hover"
    },
    {
      "id": "primary-soft",
      "name": "品牌浅底",
      "group": "颜色",
      "type": "color",
      "value": "#f0eefb",
      "description": "选中导航、焦点周边与辅助面板。",
      "cssVariable": "--color-primary-soft"
    },
    {
      "id": "on-primary",
      "name": "品牌色上文字",
      "group": "颜色",
      "type": "color",
      "value": "#ffffff",
      "description": "主按钮上的高对比文字。",
      "cssVariable": "--color-on-primary"
    },
    {
      "id": "ink",
      "name": "正文颜色",
      "group": "颜色",
      "type": "color",
      "value": "#202333",
      "description": "标题及主要正文。",
      "cssVariable": "--color-ink"
    },
    {
      "id": "muted",
      "name": "辅助文字",
      "group": "颜色",
      "type": "color",
      "value": "#626b7c",
      "description": "提示、元数据和次级说明。",
      "cssVariable": "--color-muted"
    },
    {
      "id": "surface",
      "name": "画布底色",
      "group": "颜色",
      "type": "color",
      "value": "#f7f8fc",
      "description": "应用内容区的安静底色。",
      "cssVariable": "--color-surface"
    },
    {
      "id": "card",
      "name": "卡片底色",
      "group": "颜色",
      "type": "color",
      "value": "#ffffff",
      "description": "卡片、输入框与导航的底色。",
      "cssVariable": "--color-card"
    },
    {
      "id": "border",
      "name": "分隔边框",
      "group": "颜色",
      "type": "color",
      "value": "#e1e5ed",
      "description": "组件边界、分隔线与输入框。",
      "cssVariable": "--color-border"
    },
    {
      "id": "success",
      "name": "成功状态",
      "group": "颜色",
      "type": "color",
      "value": "#287157",
      "description": "完成任务和保存成功的反馈。",
      "cssVariable": "--color-success"
    },
    {
      "id": "danger",
      "name": "错误状态",
      "group": "颜色",
      "type": "color",
      "value": "#b32938",
      "description": "字段校验与需要注意的错误。",
      "cssVariable": "--color-danger"
    },
    {
      "id": "focus",
      "name": "焦点轮廓",
      "group": "颜色",
      "type": "color",
      "value": "#aaa3ef",
      "description": "键盘导航时可见的焦点轮廓。",
      "cssVariable": "--color-focus"
    },
    {
      "id": "body",
      "name": "正文字号",
      "group": "字体",
      "type": "typography",
      "value": "16px",
      "description": "页面与组件共用的基础字号。",
      "cssVariable": "--font-body"
    },
    {
      "id": "space",
      "name": "基础间距",
      "group": "间距",
      "type": "spacing",
      "value": "8px",
      "description": "布局采用基础间距的倍数。",
      "cssVariable": "--space"
    },
    {
      "id": "radius",
      "name": "控件圆角",
      "group": "形状",
      "type": "radius",
      "value": "8px",
      "description": "按钮和输入框的统一圆角。",
      "cssVariable": "--radius"
    },
    {
      "id": "radius-card",
      "name": "卡片圆角",
      "group": "形状",
      "type": "radius",
      "value": "12px",
      "description": "项目卡片与内容面板的圆角。",
      "cssVariable": "--radius-card"
    },
    {
      "id": "shadow-card",
      "name": "卡片浮起",
      "group": "阴影",
      "type": "shadow",
      "value": "0 8px 24px #2023330a",
      "description": "悬停和弹出反馈的柔和阴影。",
      "cssVariable": "--shadow-card"
    }
  ]
