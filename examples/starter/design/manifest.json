{
  "schemaVersion": 1,
  "id": "northstar",
  "name": "Northstar · 团队协作原型",
  "devices": [
    {
      "id": "desktop",
      "name": "Desktop",
      "width": 1280,
      "height": 800
    },
    {
      "id": "mobile",
      "name": "Mobile",
      "width": 390,
      "height": 844
    }
  ],
  "pages": [
    {
      "id": "login",
      "name": "登录",
      "components": ["button", "input"],
      "states": [
        {
          "id": "default",
          "name": "默认",
          "entries": {
            "desktop": {
              "path": "pages/login.html"
            },
            "mobile": {
              "path": "pages/login.html"
            }
          }
        },
        {
          "id": "error",
          "name": "输入错误",
          "entries": {
            "desktop": {
              "path": "pages/login.html",
              "query": {
                "state": "error"
              }
            },
            "mobile": {
              "path": "pages/login.html",
              "query": {
                "state": "error"
              }
            }
          }
        },
        {
          "id": "loading",
          "name": "登录中",
          "entries": {
            "desktop": {
              "path": "pages/login.html",
              "query": {
                "state": "loading"
              }
            },
            "mobile": {
              "path": "pages/login.html",
              "query": {
                "state": "loading"
              }
            }
          }
        }
