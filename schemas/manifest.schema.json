{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "devices": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "name": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 240,
            "maximum": 7680
          },
          "height": {
            "type": "integer",
            "minimum": 160,
            "maximum": 7680
          }
        },
        "required": [
          "id",
          "name",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    },
    "pageNavigation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "pages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "name": {
            "type": "string"
          },
          "components": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            }
          },
          "states": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                },
                "name": {
                  "type": "string"
                },
                "entries": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "query": {
                        "default": {},
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "hash": {
                        "default": "",
                        "type": "string"
                      }
                    },
                    "required": [
                      "path",
                      "query",
                      "hash"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "name",
                "entries"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "components",
          "states"
        ],
        "additionalProperties": false
      }
    },
    "components": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "name": {
            "type": "string"
          },
          "implementation": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "examples": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                },
                "name": {
                  "type": "string"
                },
                "entries": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "query": {
                        "default": {},
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "hash": {
                        "default": "",
                        "type": "string"
                      }
                    },
                    "required": [
                      "path",
                      "query",
                      "hash"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "name",
                "entries"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "implementation",
          "examples"
        ],
        "additionalProperties": false
      }
    },
    "tokens": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "color",
              "typography",
              "spacing",
              "radius",
              "shadow",
              "other"
            ]
          },
          "value": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "cssVariable": {
            "type": "string",
            "pattern": "^--[\\w-]+$"
          }
        },
        "required": [
          "id",
          "name",
          "group",
          "type",
          "value",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "devices",
    "pages",
    "components",
    "tokens"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "pageId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  }
}
